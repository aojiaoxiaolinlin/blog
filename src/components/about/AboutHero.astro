---
import "../../styles/components/about-hero.css";
---

<section class="about-hero">
    <!-- 左侧文字 -->
    <div class="hero-l">
        <div class="hero-eyebrow"><span></span>个人简历 · 关于我</div>
        <div class="hero-name">void</div>
        <div class="hero-alias">/ 傲娇小霖霖</div>

        <div class="typewriter-wrap">
            <span class="tw-prefix">$&gt;</span>
            <span class="tw-text" id="twText"></span><span class="tw-cursor"
            ></span>
        </div>

        <p class="hero-bio">
            图形工程师 & 技术写作者。痴迷于把晦涩的 GPU
            管线变成能在浏览器跑起来的实验。
            相信好的工程美学和好的代码一样重要——两者都是关于<em class="hero-bio-em">可读性</em>的。
        </p>

        <div class="hero-actions">
            <a href="#contact" class="btn btn-fill">联系我</a>
            <a href="#projects" class="btn btn-line">查看项目 →</a>
            <a href="/" class="btn btn-line">阅读博客 →</a>
        </div>
    </div>

    <!-- 右侧视觉 -->
    <div class="hero-r">
        <div class="orb orb1"></div>
        <div class="orb orb2"></div>
        <div class="orb orb3"></div>
        <canvas id="hero-cv"></canvas>
        <div class="hero-grid-lines"></div>

        <!-- 悬浮统计卡 -->
        <div class="hero-card hc1">
            <div class="hc-label">工作经验</div>
            <div class="hc-val">
                5<span class="hc-unit"> yr</span>
            </div>
            <div class="hc-sub">图形渲染 & 前端工程</div>
            <div class="hc-bar">
                <div class="hc-bar-fill fill-82"></div>
            </div>
        </div>

        <div class="hero-card hc2">
            <div class="hc-label">开源贡献</div>
            <div class="hc-val">
                1.2<span class="hc-unit">k</span>
            </div>
            <div class="hc-sub">GitHub Stars · 12 repositories</div>
            <div class="hc-bar">
                <div class="hc-bar-fill fill-65 tone-mint"></div>
            </div>
        </div>

        <div class="hero-card hc3">
            <div class="hc-label">技术文章</div>
            <div class="hc-val">
                47<span class="hc-unit"> +</span>
            </div>
            <div class="hc-sub">WebGPU · Rust · 图形学</div>
            <div class="hc-bar">
                <div class="hc-bar-fill fill-55 tone-warm"></div>
            </div>
        </div>
    </div>
</section>

<script>
    /* ══ Typewriter ══ */
    const titles = [
        "WebGPU 渲染工程师",
        "技术写作者 & 博主",
        "Rust / WASM 探索者",
        "开源项目维护者",
        "图形学爱好者",
    ];
    let ti = 0,
        ci = 0,
        deleting = false;
    const twEl = document.getElementById("twText");
    if (twEl) {
        function typeStep() {
            const cur = titles[ti];
            if (!deleting) {
                twEl!.textContent = cur.slice(0, ++ci);
                if (ci === cur.length) {
                    deleting = true;
                    setTimeout(typeStep, 2200);
                    return;
                }
            } else {
                twEl!.textContent = cur.slice(0, --ci);
                if (ci === 0) {
                    deleting = false;
                    ti = (ti + 1) % titles.length;
                    setTimeout(typeStep, 400);
                    return;
                }
            }
            setTimeout(typeStep, deleting ? 50 : 80);
        }
        setTimeout(typeStep, 1200);
    }

    /* ══ Hero Canvas — wave + particles ══ */
    const cv = document.getElementById("hero-cv") as HTMLCanvasElement | null;
    if (cv) {
        const ctx = cv.getContext("2d");
        if (ctx) {
            function resize() {
                if (cv) {
                    cv.width = cv.offsetWidth || 600;
                    cv.height = cv.offsetHeight || 700;
                }
            }
            resize();
            if (cv.parentElement) {
                new ResizeObserver(resize).observe(cv.parentElement);
            }

            const N = 80;
            const pts = Array.from({ length: N }, () => ({
                x: Math.random(),
                y: Math.random(),
                vx: (Math.random() - 0.5) * 0.0005,
                vy: (Math.random() - 0.5) * 0.0005,
                r: Math.random() * 1.4 + 0.3,
                ph: Math.random() * Math.PI * 2,
            }));
            const waves = [
                {
                    amp: 0.05,
                    freq: 2,
                    speed: 0.35,
                    ph: 0,
                    c: "rgba(124,106,245,",
                    lw: 1.4,
                },
                {
                    amp: 0.032,
                    freq: 3.2,
                    speed: 0.52,
                    ph: 1.1,
                    c: "rgba(106,245,200,",
                    lw: 0.9,
                },
                {
                    amp: 0.022,
                    freq: 5,
                    speed: 0.78,
                    ph: 2.4,
                    c: "rgba(245,162,106,",
                    lw: 0.7,
                },
            ];
            let t = 0;
            function draw() {
                if (!cv || !ctx) return;
                const W = cv.width,
                    H = cv.height;
                if (!W || !H) {
                    t += 0.016;
                    requestAnimationFrame(draw);
                    return;
                }
                ctx.clearRect(0, 0, W, H);
                ctx.fillStyle = "#07070e";
                ctx.fillRect(0, 0, W, H);
                // waves
                waves.forEach((w) => {
                    const cy = H * 0.42;
                    [0.04, 0.55].forEach((alpha) => {
                        ctx.beginPath();
                        for (let x = 0; x <= W; x++) {
                            const nx = x / W;
                            const y =
                                cy +
                                Math.sin(
                                    nx * Math.PI * 2 * w.freq +
                                        t * w.speed +
                                        w.ph,
                                ) *
                                    H *
                                    w.amp +
                                Math.sin(
                                    nx * Math.PI * 2 * w.freq * 1.8 +
                                        t * w.speed * 0.5 +
                                        w.ph,
                                ) *
                                    H *
                                    w.amp *
                                    0.35;
                            x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
                        }
                        ctx.strokeStyle = w.c + alpha + ")";
                        ctx.lineWidth = alpha > 0.1 ? w.lw : w.lw * 9;
                        ctx.stroke();
                    });
                });
                // particles
                pts.forEach((p) => {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0) p.x = 1;
                    if (p.x > 1) p.x = 0;
                    if (p.y < 0) p.y = 1;
                    if (p.y > 1) p.y = 0;
                    const a = 0.25 + Math.sin(t * 1.1 + p.ph) * 0.2;
                    ctx.beginPath();
                    ctx.arc(p.x * W, p.y * H, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(150,138,255,${a})`;
                    ctx.fill();
                });
                // connections
                for (let i = 0; i < N; i++)
                    for (let j = i + 1; j < N; j++) {
                        const dx = (pts[i].x - pts[j].x) * W,
                            dy = (pts[i].y - pts[j].y) * H;
                        const d = Math.sqrt(dx * dx + dy * dy);
                        if (d < 70) {
                            ctx.strokeStyle = `rgba(124,106,245,${(1 - d / 70) * 0.15})`;
                            ctx.lineWidth = 0.5;
                            ctx.beginPath();
                            ctx.moveTo(pts[i].x * W, pts[i].y * H);
                            ctx.lineTo(pts[j].x * W, pts[j].y * H);
                            ctx.stroke();
                        }
                    }
                // scan line
                const sy = ((t * 0.1) % 1) * H;
                const sg = ctx.createLinearGradient(0, sy - 1, 0, sy + 2);
                sg.addColorStop(0, "transparent");
                sg.addColorStop(0.5, "rgba(124,106,245,.2)");
                sg.addColorStop(1, "transparent");
                ctx.fillStyle = sg;
                ctx.fillRect(0, sy - 2, W, 4);
                t += 0.016;
                requestAnimationFrame(draw);
            }
            draw();
        }
    }
</script>

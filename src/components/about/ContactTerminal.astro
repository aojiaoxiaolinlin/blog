---
---
<section id="contact" class="contact-section">
  <div class="wrap">
    <div class="section-hd rv">
      <div><div class="section-label" style="font-size:.63rem;color:var(--accent);letter-spacing:.22em;text-transform:uppercase;margin-bottom:8px">联系方式</div>
      <h2 class="section-title">Get in Touch</h2></div>
    </div>

    <div class="contact-layout">
      <div class="contact-left rv">
        <h2>有想法？<br><em>一起聊聊</em></h2>
        <p>
          对 WebGPU、图形渲染、Rust/WASM 有问题，或者想找我合作一个有意思的项目，
          都欢迎发消息。回复通常在 24h 内。
        </p>
        <div class="contact-links">
          <a href="mailto:void@dev.io" class="cl-item">
            <span class="cl-icon">✉️</span>
            <div class="cl-info">
              <div class="cl-platform">Email</div>
              <div class="cl-handle">void@dev.io</div>
            </div>
            <span style="font-size:.65rem;color:var(--muted)">→</span>
          </a>
          <a href="#" class="cl-item">
            <span class="cl-icon">⬡</span>
            <div class="cl-info">
              <div class="cl-platform">GitHub</div>
              <div class="cl-handle">github.com/void-dev</div>
            </div>
            <span style="font-size:.65rem;color:var(--muted)">→</span>
          </a>
          <a href="#" class="cl-item">
            <span class="cl-icon">𝕏</span>
            <div class="cl-info">
              <div class="cl-platform">Twitter / X</div>
              <div class="cl-handle">@void_graphics</div>
            </div>
            <span style="font-size:.65rem;color:var(--muted)">→</span>
          </a>
          <a href="#" class="cl-item">
            <span class="cl-icon">💬</span>
            <div class="cl-info">
              <div class="cl-platform">微信公众号</div>
              <div class="cl-handle">VOID_dev</div>
            </div>
            <span style="font-size:.65rem;color:var(--muted)">→</span>
          </a>
        </div>
      </div>

      <!-- 终端 -->
      <div class="rv d2">
        <div class="terminal">
          <div class="term-bar">
            <div class="term-dot" style="background:#f56a6a"></div>
            <div class="term-dot" style="background:var(--accent2)"></div>
            <div class="term-dot" style="background:var(--accent3)"></div>
            <span class="term-title-txt">contact — void@dev.io — zsh</span>
          </div>
          <div class="term-body" id="termBody">
            <div class="tl"><span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span><span class="tl-w">whoami</span></div>
            <div class="tl" style="margin-bottom:8px"><span class="tl-m">  → Graphics Engineer | Writer | Open Source</span></div>
            <div class="tl"><span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span><span class="tl-w">cat status.txt</span></div>
            <div class="tl"><span class="tl-m">  → </span><span class="tl-g">✓ </span><span class="tl-w">Available for freelance projects</span></div>
            <div class="tl"><span class="tl-m">  → </span><span class="tl-g">✓ </span><span class="tl-w">Open to interesting collaborations</span></div>
            <div class="tl" style="margin-bottom:8px"><span class="tl-m">  → </span><span class="tl-y">~ </span><span class="tl-w">Not actively job hunting</span></div>
            <div class="tl"><span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span><span class="tl-w">ping void@dev.io</span></div>
            <div class="tl"><span class="tl-m">  Pinging void@dev.io...</span></div>
            <div class="tl" style="margin-bottom:8px"><span class="tl-g">  Reply: avg response &lt; 24h</span></div>
            <div class="tl" id="termCmdLine"><span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span><span id="termTyped" class="tl-w"></span></div>
          </div>
          <div class="term-input-row">
            <span class="term-prompt">$</span>
            <input type="text" id="termInput" placeholder="输入消息，按 Enter 发送..." spellcheck="false">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ══════════════════════════════════════
   CONTACT  — 终端风格
══════════════════════════════════════ */
.contact-section{
  background:var(--bg2);
  border-top:1px solid var(--border);
}
.contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
.contact-left h2{
  font-family:'Playfair Display',serif;
  font-size:clamp(2rem,3.2vw,3rem);
  font-weight:900;letter-spacing:-.04em;line-height:1.1;color:#fff;
  margin-bottom:20px}
.contact-left h2 em{font-style:italic;color:var(--accent2)}
.contact-left p{
  font-family:'Noto Serif SC',serif;font-size:.92rem;
  color:var(--text2);line-height:1.85;margin-bottom:32px}
.contact-links{display:flex;flex-direction:column;gap:12px}
.cl-item{
  display:flex;align-items:center;gap:16px;padding:14px 18px;
  border:1px solid var(--border);border-radius:6px;
  text-decoration:none;color:inherit;
  background:var(--surface);cursor:none;
  transition:background .2s,border-color .2s,transform .2s;
  position:relative;overflow:hidden;
}
.cl-item:hover{background:var(--surface2);border-color:var(--border2);transform:translateX(4px)}
.cl-item::before{content:'';position:absolute;left:0;top:0;bottom:0;
  width:2px;background:var(--accent);transform:scaleY(0);
  transition:transform .3s cubic-bezier(.23,1,.32,1)}
.cl-item:hover::before{transform:scaleY(1)}
.cl-icon{font-size:1rem;flex-shrink:0}
.cl-info{flex:1}
.cl-platform{font-size:.6rem;color:var(--muted);letter-spacing:.12em;text-transform:uppercase;margin-bottom:3px}
.cl-handle{font-size:.82rem;color:var(--text)}

/* 终端 */
.terminal{
  background:#050512;border:1px solid var(--border2);border-radius:10px;
  overflow:hidden;box-shadow:0 16px 48px rgba(0,0,0,.6);
}
.term-bar{
  display:flex;align-items:center;gap:8px;padding:12px 16px;
  background:var(--surface2);border-bottom:1px solid var(--border)}
.term-dot{width:11px;height:11px;border-radius:50%}
.term-title-txt{font-size:.62rem;color:var(--muted);margin-left:8px;letter-spacing:.08em}
.term-body{padding:20px 20px 8px;font-size:.75rem;line-height:1.9;min-height:280px}
:global(.tl){display:flex;gap:0}
:global(.tl-g){color:var(--accent3)}
:global(.tl-y){color:var(--accent2)}
:global(.tl-p){color:var(--accent)}
:global(.tl-w){color:#fff}
:global(.tl-m){color:var(--muted)}
/* 输入行 */
.term-input-row{
  display:flex;align-items:center;gap:8px;
  padding:8px 20px 20px;border-top:1px solid var(--border);margin-top:8px}
.term-prompt{font-size:.75rem;color:var(--accent3);flex-shrink:0}
#termInput{
  flex:1;background:none;border:none;outline:none;
  font-family:'JetBrains Mono',monospace;font-size:.75rem;color:var(--text);
  letter-spacing:.04em;cursor:none;caret-color:var(--accent)}
#termInput::placeholder{color:var(--muted)}

@media (max-width: 900px) {
  .contact-layout {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}
</style>

<script>
/* ══ Terminal input ══ */
const termInput=document.getElementById('termInput') as HTMLInputElement | null;
const termBody=document.getElementById('termBody');
const cmdLine=document.getElementById('termCmdLine');

if(termInput && termBody) {
  const responses: Record<string, string> = {
    help:  '可用命令: whoami · skills · contact · clear',
    skills:'WebGPU · WGSL · Rust · WASM · TypeScript · Three.js · React',
    contact:'void@dev.io | github.com/void-dev | @void_graphics',
    clear: '__clear__',
  };
  
  termInput.addEventListener('keydown',e=>{
    if(e.key!=='Enter')return;
    const cmd=termInput.value.trim().toLowerCase();
    termInput.value='';
    if(!cmd)return;
    
    // Append new command line
    const cl=document.createElement('div');cl.className='tl';
    cl.innerHTML=`<span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span><span class="tl-w">${cmd}</span>`;
    
    // remove old cursor line and append new
    if(cmdLine&&cmdLine.parentNode)cmdLine.remove();
    termBody.appendChild(cl);
    
    const res=responses[cmd]||`command not found: ${cmd}. Try 'help'`;
    if(res==='__clear__'){
      termBody.innerHTML='';
      
      const nl=document.createElement('div');nl.className='tl';nl.id='termCmdLine';
      nl.innerHTML=`<span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span>`;
      termBody.appendChild(nl);
      return;
    }
    
    const rl=document.createElement('div');rl.className='tl';
    rl.innerHTML=`<span class="tl-m">  → </span><span class="tl-g">${res}</span>`;
    termBody.appendChild(rl);
    
    // re-add prompt line
    const nl=document.createElement('div');nl.className='tl';nl.id='termCmdLine';
    nl.innerHTML=`<span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span>`;
    termBody.appendChild(nl);
    termBody.scrollTop=termBody.scrollHeight;
  });
  
  termInput.addEventListener('focus',()=>{termInput.placeholder=''});
  termInput.addEventListener('blur',()=>{termInput.placeholder='输入消息，按 Enter 发送...'});
  // Focus terminal on click
  const terminal = document.querySelector('.terminal');
  if(terminal) terminal.addEventListener('click',()=>termInput.focus());
}
</script>

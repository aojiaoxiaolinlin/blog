---
import SectionHeader from "../ui/SectionHeader.astro";
import "../../styles/components/about-contact-terminal.css";

const contactLinks = [
  {
    href: "mailto:void@dev.io",
    icon: "✉️",
    platform: "Email",
    handle: "void@dev.io",
  },
  {
    href: "#",
    icon: "⬡",
    platform: "GitHub",
    handle: "github.com/void-dev",
  },
  {
    href: "#",
    icon: "𝕏",
    platform: "Twitter / X",
    handle: "@void_graphics",
  },
  {
    href: "#",
    icon: "💬",
    platform: "微信公众号",
    handle: "VOID_dev",
  },
];
---

<section id="contact" class="contact-section">
  <div class="wrap">
    <SectionHeader label="联系方式" title="Get in Touch" />

    <div class="contact-layout">
      <div class="contact-left rv">
        <h2>有想法？<br /><em>一起聊聊</em></h2>
        <p>
          对 WebGPU、图形渲染、Rust/WASM
          有问题，或者想找我合作一个有意思的项目， 都欢迎发消息。回复通常在 24h
          内。
        </p>
        <div class="contact-links">
          {
            contactLinks.map((item) => (
              <a
                href={item.href}
                class="cl-item panel-card panel-card--interactive"
              >
                <span class="cl-icon">{item.icon}</span>
                <div class="cl-info">
                  <div class="cl-platform mono-label">{item.platform}</div>
                  <div class="cl-handle">{item.handle}</div>
                </div>
                <span class="cl-arrow">→</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- 终端 -->
      <div class="rv d2">
        <div class="terminal panel-card">
          <div class="term-bar">
            <div class="term-dot is-danger"></div>
            <div class="term-dot is-warm"></div>
            <div class="term-dot is-mint"></div>
            <span class="term-title-txt mono-label"
              >contact — void@dev.io — zsh</span
            >
          </div>
          <div class="term-body" id="termBody">
            <div class="tl">
              <span class="tl-g">void@dev</span><span class="tl-m">:</span><span
                class="tl-p">~</span
              ><span class="tl-m">$ </span><span class="tl-w">whoami</span>
            </div>
            <div class="tl tl-gap">
              <span class="tl-m">
                → Graphics Engineer | Writer | Open Source</span
              >
            </div>
            <div class="tl">
              <span class="tl-g">void@dev</span><span class="tl-m">:</span><span
                class="tl-p">~</span
              ><span class="tl-m">$ </span><span class="tl-w"
                >cat status.txt</span
              >
            </div>
            <div class="tl">
              <span class="tl-m"> → </span><span class="tl-g">✓ </span><span
                class="tl-w">Available for freelance projects</span
              >
            </div>
            <div class="tl">
              <span class="tl-m"> → </span><span class="tl-g">✓ </span><span
                class="tl-w">Open to interesting collaborations</span
              >
            </div>
            <div class="tl tl-gap">
              <span class="tl-m"> → </span><span class="tl-y">~ </span><span
                class="tl-w">Not actively job hunting</span
              >
            </div>
            <div class="tl">
              <span class="tl-g">void@dev</span><span class="tl-m">:</span><span
                class="tl-p">~</span
              ><span class="tl-m">$ </span><span class="tl-w"
                >ping void@dev.io</span
              >
            </div>
            <div class="tl">
              <span class="tl-m"> Pinging void@dev.io...</span>
            </div>
            <div class="tl tl-gap">
              <span class="tl-g"> Reply: avg response &lt; 24h</span>
            </div>
            <div class="tl" id="termCmdLine">
              <span class="tl-g">void@dev</span><span class="tl-m">:</span><span
                class="tl-p">~</span
              ><span class="tl-m">$ </span><span id="termTyped" class="tl-w"
              ></span>
            </div>
          </div>
          <div class="term-input-row">
            <span class="term-prompt">$</span>
            <input
              type="text"
              id="termInput"
              placeholder="输入消息，按 Enter 发送..."
              spellcheck="false"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* ══ Terminal input ══ */
  const termInput = document.getElementById(
    "termInput",
  ) as HTMLInputElement | null;
  const termBody = document.getElementById("termBody");
  const cmdLine = document.getElementById("termCmdLine");

  if (termInput && termBody) {
    const responses: Record<string, string> = {
      help: "可用命令: whoami · skills · contact · clear",
      skills: "WebGPU · WGSL · Rust · WASM · TypeScript · Three.js · React",
      contact: "void@dev.io | github.com/void-dev | @void_graphics",
      clear: "__clear__",
    };

    termInput.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      const cmd = termInput.value.trim().toLowerCase();
      termInput.value = "";
      if (!cmd) return;

      // Append new command line
      const cl = document.createElement("div");
      cl.className = "tl";
      cl.innerHTML = `<span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span><span class="tl-w">${cmd}</span>`;

      // remove old cursor line and append new
      if (cmdLine && cmdLine.parentNode) cmdLine.remove();
      termBody.appendChild(cl);

      const res = responses[cmd] || `command not found: ${cmd}. Try 'help'`;
      if (res === "__clear__") {
        termBody.innerHTML = "";

        const nl = document.createElement("div");
        nl.className = "tl";
        nl.id = "termCmdLine";
        nl.innerHTML = `<span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span>`;
        termBody.appendChild(nl);
        return;
      }

      const rl = document.createElement("div");
      rl.className = "tl";
      rl.innerHTML = `<span class="tl-m">  → </span><span class="tl-g">${res}</span>`;
      termBody.appendChild(rl);

      // re-add prompt line
      const nl = document.createElement("div");
      nl.className = "tl";
      nl.id = "termCmdLine";
      nl.innerHTML = `<span class="tl-g">void@dev</span><span class="tl-m">:</span><span class="tl-p">~</span><span class="tl-m">$ </span>`;
      termBody.appendChild(nl);
      termBody.scrollTop = termBody.scrollHeight;
    });

    termInput.addEventListener("focus", () => {
      termInput.placeholder = "";
    });
    termInput.addEventListener("blur", () => {
      termInput.placeholder = "输入消息，按 Enter 发送...";
    });
    // Focus terminal on click
    const terminal = document.querySelector(".terminal");
    if (terminal) terminal.addEventListener("click", () => termInput.focus());
  }
</script>

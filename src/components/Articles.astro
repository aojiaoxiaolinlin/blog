---
import SectionHeader from "./ui/SectionHeader.astro";
import { getRecentArticles } from "../lib/content-data";
import { formatDate, getEntryPath, getTagColorClass } from "../lib/content";
import "../styles/components/articles.css";

const articlesWithRender = await getRecentArticles(5);
---

<section id="articles">
  <div class="wrap">
    <SectionHeader
      label="精选文章"
      title="最近写了些什么"
      href="/articles"
      linkText="全部文章"
    />
    <div class="art-grid rv">
      {
        articlesWithRender.map(({ entry, metrics }, index) => {
          const { title, description, date, tags, layoutStyle } = entry.data;
          const numStr = String(index + 1).padStart(2, "0");
          const styleClass = layoutStyle ? `ac-${layoutStyle}` : "ac-sm";

          return (
            <a href={getEntryPath(entry)} class={`ac ${styleClass}`}>
              {styleClass !== "ac-sm" && <div class="ac-num">{numStr}</div>}
              <div class="ac-meta">
                {tags &&
                  tags.map((tag) => (
                    <span class={`tag ${getTagColorClass(tag)}`}>{tag}</span>
                  ))}
                <span>{formatDate(date)}</span>
                {styleClass !== "ac-sm" &&
                  tags &&
                  tags.includes("深度长文") && <span>·</span>}
                {styleClass !== "ac-sm" &&
                  tags &&
                  tags.includes("深度长文") && <span>深度长文</span>}
              </div>
              <h3 class="ac-title">{title}</h3>
              {styleClass !== "ac-sm" && (
                <p class="ac-excerpt">{description}</p>
              )}
              <div class="ac-foot">
                <span>
                  ⌛ {metrics.minutesRead} 分钟{styleClass === "ac-feat" && "阅读"}
                </span>
                {styleClass !== "ac-sm" && (
                  <span>{metrics.characterCount.toLocaleString()} 字</span>
                )}
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

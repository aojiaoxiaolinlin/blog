---
import { getCollection, render } from "astro:content";
import SectionHeader from "./ui/SectionHeader.astro";
import "../styles/components/articles.css";

const allArticles = await getCollection("articles");
const sortedArticles = allArticles.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const articles = sortedArticles.slice(0, 5);

const articlesWithRender = await Promise.all(
  articles.map(async (article) => {
    const { remarkPluginFrontmatter } = await render(article);
    return { ...article, remarkPluginFrontmatter };
  }),
);

const formatDate = (date: Date) => {
  const yy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  return `${yy}.${mm}.${dd}`;
};

const getTagColorClass = (tag: string) => {
  const t = tag.toLowerCase();
  if (t.includes("gpu") || t.includes("glsl")) return "gpu";
  if (t.includes("wasm") || t.includes("rust")) return "wasm";
  if (t.includes("css") || t.includes("web")) return "web";
  return "note";
};
---

<section id="articles">
  <div class="wrap">
    <SectionHeader
      label="精选文章"
      title="最近写了些什么"
      href="/articles"
      linkText="全部文章"
    />
    <div class="art-grid rv">
      {
        articlesWithRender.map((article, index) => {
          const { title, description, date, tags, layoutStyle } = article.data;
          const readTime = article.remarkPluginFrontmatter?.minutesRead;
          const numStr = String(index + 1).padStart(2, "0");
          const styleClass = layoutStyle ? `ac-${layoutStyle}` : "ac-sm";

          return (
            <a href={`/articles/${article.id}`} class={`ac ${styleClass}`}>
              {styleClass !== "ac-sm" && <div class="ac-num">{numStr}</div>}
              <div class="ac-meta">
                {tags &&
                  tags.map((tag) => (
                    <span class={`tag ${getTagColorClass(tag)}`}>{tag}</span>
                  ))}
                <span>{formatDate(date)}</span>
                {styleClass !== "ac-sm" &&
                  tags &&
                  tags.includes("深度长文") && <span>·</span>}
                {styleClass !== "ac-sm" &&
                  tags &&
                  tags.includes("深度长文") && <span>深度长文</span>}
              </div>
              <h3 class="ac-title">{title}</h3>
              {styleClass !== "ac-sm" && (
                <p class="ac-excerpt">{description}</p>
              )}
              <div class="ac-foot">
                <span>
                  ⌛ {readTime || 5} 分钟{styleClass === "ac-feat" && "阅读"}
                </span>
                {styleClass !== "ac-sm" && (
                  <span>{Math.floor(Math.random() * 2000) + 1000} 次阅读</span>
                )}
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

---
import { getCollection, render } from "astro:content";

const allArticles = await getCollection("articles");
const sortedArticles = allArticles.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const articles = sortedArticles.slice(0, 5);

const articlesWithRender = await Promise.all(
  articles.map(async (article) => {
    const { remarkPluginFrontmatter } = await render(article);
    return { ...article, remarkPluginFrontmatter };
  }),
);

const formatDate = (date: Date) => {
  const yy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  return `${yy}.${mm}.${dd}`;
};

const getTagColorClass = (tag: string) => {
  const t = tag.toLowerCase();
  if (t.includes("gpu") || t.includes("glsl")) return "gpu";
  if (t.includes("wasm") || t.includes("rust")) return "wasm";
  if (t.includes("css") || t.includes("web")) return "web";
  return "note";
};
---

<section id="articles">
  <div class="wrap">
    <div class="section-hd rv">
      <div>
        <div class="section-label">精选文章</div><h2 class="section-title">
          最近写了些什么
        </h2>
      </div>
      <a href="/articles" class="section-link">全部文章</a>
    </div>
    <div class="art-grid rv">
      {
        articlesWithRender.map((article, index) => {
          const { title, description, date, tags, layoutStyle } = article.data;
          const readTime = article.remarkPluginFrontmatter?.minutesRead;
          const numStr = String(index + 1).padStart(2, "0");
          const styleClass = layoutStyle ? `ac-${layoutStyle}` : "ac-sm";

          return (
            <a href={`/articles/${article.id}`} class={`ac ${styleClass}`}>
              {styleClass !== "ac-sm" && <div class="ac-num">{numStr}</div>}
              <div class="ac-meta">
                {tags &&
                  tags.map((tag) => (
                    <span class={`tag ${getTagColorClass(tag)}`}>{tag}</span>
                  ))}
                <span>{formatDate(date)}</span>
                {styleClass !== "ac-sm" &&
                  tags &&
                  tags.includes("深度长文") && <span>·</span>}
                {styleClass !== "ac-sm" &&
                  tags &&
                  tags.includes("深度长文") && <span>深度长文</span>}
              </div>
              <h3 class="ac-title">{title}</h3>
              {styleClass !== "ac-sm" && (
                <p class="ac-excerpt">{description}</p>
              )}
              <div class="ac-foot">
                <span>
                  ⌛ {readTime || 5} 分钟{styleClass === "ac-feat" && "阅读"}
                </span>
                {styleClass !== "ac-sm" && (
                  <span>{Math.floor(Math.random() * 2000) + 1000} 次阅读</span>
                )}
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* ARTICLES */
  .art-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .ac {
    background: var(--bg);
    padding: 36px 32px;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: background 0.3s;
  }
  .ac:hover {
    background: var(--surface);
  }
  .ac::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--accent);
    transition: height 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .ac:hover::before {
    height: 100%;
  }
  .ac-feat {
    grid-column: span 7;
    background: linear-gradient(
      135deg,
      var(--bg) 60%,
      rgba(124, 106, 245, 0.04)
    );
  }
  .ac-sec {
    grid-column: span 5;
  }
  .ac-sm {
    grid-column: span 4;
  }
  .ac-num {
    font-size: 5rem;
    font-weight: 700;
    font-family: "Playfair Display", serif;
    color: rgba(124, 106, 245, 0.07);
    position: absolute;
    top: 12px;
    right: 20px;
    line-height: 1;
    pointer-events: none;
  }
  .ac-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    font-size: 0.63rem;
    color: var(--muted);
  }
  .ac-title {
    font-family: "Playfair Display", serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 10px;
    transition: color 0.2s;
  }
  .ac-feat .ac-title {
    font-size: 1.85rem;
  }
  .ac-sec .ac-title {
    font-size: 1.3rem;
  }
  .ac-sm .ac-title {
    font-size: 1.05rem;
  }
  .ac:hover .ac-title {
    color: var(--accent);
  }
  .ac-excerpt {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.8;
    font-family: "Noto Serif SC", serif;
    font-weight: 300;
  }
  .ac-sm .ac-excerpt {
    display: none;
  }
  .ac-foot {
    margin-top: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.65rem;
    color: var(--muted);
  }
</style>

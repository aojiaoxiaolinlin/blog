---
import { getCollection } from "astro:content";
import SectionHeader from "./ui/SectionHeader.astro";
import "../styles/components/notes.css";

const allNotes = await getCollection("notes");
const sortedNotes = allNotes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const notes = sortedNotes.slice(0, 5);

const formatNoteDate = (date: Date) => {
  const yy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  return { y: String(yy), md: `${mm}.${dd}` };
};

const getTagColorClass = (tag: string) => {
  const t = tag.toLowerCase();
  if (t.includes("gpu") || t.includes("glsl")) return "gpu";
  if (t.includes("wasm") || t.includes("rust")) return "wasm";
  if (t.includes("css") || t.includes("web")) return "web";
  return "note";
};
---

<section id="notes">
  <div class="wrap">
    <div class="notes-layout">
      <div>
        <SectionHeader
          label="思维碎片"
          title="笔记与随记"
          href="/notes"
          linkText="全部笔记"
        />
        <div class="note-list">
          {
            notes.map((note, index) => {
              const dt = formatNoteDate(note.data.date);
              return (
                <a
                  href={`/notes/${note.id}`}
                  class={`ni rv ${index > 0 ? `d${Math.min(index, 3)}` : ""}`}
                >
                  <div class="ni-date">
                    {dt.y}
                    <br />
                    {dt.md}
                  </div>
                  <div class="ni-title">{note.data.title}</div>
                  <div class="ni-tags">
                    {note.data.tags &&
                      note.data.tags.map((tag) => (
                        <span class={`tag ${getTagColorClass(tag)}`}>
                          {tag}
                        </span>
                      ))}
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
      <aside class="notes-sidebar rv">
        <div class="section-label mb-5">本站数据</div>
        <div class="stat-row">
          <span class="stat-label">文章总数</span><span
            class="stat-val"
            data-c="47">0</span
          >
        </div>
        <div class="stat-row">
          <span class="stat-label">总阅读量</span><span
            class="stat-val"
            data-c="128450">0</span
          >
        </div>
        <div class="stat-row">
          <span class="stat-label">交互实验</span><span
            class="stat-val"
            data-c="12">0</span
          >
        </div>
        <div class="stat-row">
          <span class="stat-label">写作天数</span><span
            class="stat-val"
            data-c="730">0</span
          >
        </div>
        <div class="tech-panel">
          <div class="tech-panel-title">技术主题分布</div>
          <div class="tb">
            <div class="tb-lbl">
              <span>WebGPU / 图形</span><span>42%</span>
            </div><div class="tb-track">
              <div class="tb-fill f1" data-w="42%"></div>
            </div>
          </div>
          <div class="tb">
            <div class="tb-lbl">
              <span>Rust / WASM</span><span>28%</span>
            </div><div class="tb-track">
              <div class="tb-fill f2" data-w="28%"></div>
            </div>
          </div>
          <div class="tb">
            <div class="tb-lbl"><span>Web 前端</span><span>18%</span></div><div
              class="tb-track"
            >
              <div class="tb-fill f3" data-w="18%"></div>
            </div>
          </div>
          <div class="tb">
            <div class="tb-lbl"><span>随笔思考</span><span>12%</span></div><div
              class="tb-track"
            >
              <div class="tb-fill f4" data-w="12%"></div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  // ─── Count up ───
  const cObs = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        const target = +(el?.dataset?.c || "0");
        let s = null;
        (function step(now) {
          if (!s) s = now;
          const p = Math.min((now - s) / 1800, 1),
            ease = 1 - Math.pow(1 - p, 4);
          el.textContent = Math.floor(ease * target).toLocaleString();
          if (p < 1) requestAnimationFrame(step);
          else el.textContent = target.toLocaleString();
        })(performance.now());
        cObs.unobserve(el);
      }),
    { threshold: 0.5 },
  );
  document.querySelectorAll("[data-c]").forEach((el) => cObs.observe(el));

  // ─── Tech bars ───
  const bObs = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        el.style.width = el.dataset.w || "0";
      }),
    { threshold: 0.3 },
  );
  document.querySelectorAll(".tb-fill").forEach((b) => bObs.observe(b));
</script>

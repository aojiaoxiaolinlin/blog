---
import SectionHeader from "./ui/SectionHeader.astro";
import { getRecentNotes, getSiteStats } from "../lib/content-data";
import {
  formatNoteDate,
  getEntryPath,
  getTagColorClass,
} from "../lib/content";
import "../styles/components/notes.css";

const [notes, siteStats] = await Promise.all([getRecentNotes(5), getSiteStats()]);
---

<section id="notes">
  <div class="wrap">
    <div class="notes-layout">
      <div>
        <SectionHeader
          label="思维碎片"
          title="笔记与随记"
          href="/notes"
          linkText="全部笔记"
        />
        <div class="note-list">
          {
            notes.map(({ entry: note }, index) => {
              const dt = formatNoteDate(note.data.date);
              return (
                <a
                  href={getEntryPath(note)}
                  class={`ni rv ${index > 0 ? `d${Math.min(index, 3)}` : ""}`}
                >
                  <div class="ni-date">
                    {dt.y}
                    <br />
                    {dt.md}
                  </div>
                  <div class="ni-title">{note.data.title}</div>
                  <div class="ni-tags">
                    {note.data.tags &&
                      note.data.tags.map((tag) => (
                        <span class={`tag ${getTagColorClass(tag)}`}>
                          {tag}
                        </span>
                      ))}
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
      <aside class="notes-sidebar rv">
        <div class="section-label mb-5">本站数据</div>
        <div class="stat-row">
          <span class="stat-label">文章总数</span><span
            class="stat-val"
            data-c={siteStats.articleCount}>0</span
          >
        </div>
        <div class="stat-row">
          <span class="stat-label">笔记总数</span><span
            class="stat-val"
            data-c={siteStats.noteCount}>0</span
          >
        </div>
        <div class="stat-row">
          <span class="stat-label">总阅读分钟</span><span
            class="stat-val"
            data-c={siteStats.totalReadMinutes}>0</span
          >
        </div>
        <div class="stat-row">
          <span class="stat-label">写作天数</span><span
            class="stat-val"
            data-c={siteStats.writingDays}>0</span
          >
        </div>
        <div class="tech-panel">
          <div class="tech-panel-title">技术主题分布</div>
          {
            siteStats.tagDistribution.map((item) => (
              <div class="tb">
                <div class="tb-lbl">
                  <span>{item.label}</span><span>{item.percentage}%</span>
                </div><div class="tb-track">
                  <div
                    class={`tb-fill ${item.className}`}
                    data-w={`${item.percentage}%`}
                  ></div>
                </div>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  // ─── Count up ───
  const cObs = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        const target = +(el?.dataset?.c || "0");
        let s = null;
        (function step(now) {
          if (!s) s = now;
          const p = Math.min((now - s) / 1800, 1),
            ease = 1 - Math.pow(1 - p, 4);
          el.textContent = Math.floor(ease * target).toLocaleString();
          if (p < 1) requestAnimationFrame(step);
          else el.textContent = target.toLocaleString();
        })(performance.now());
        cObs.unobserve(el);
      }),
    { threshold: 0.5 },
  );
  document.querySelectorAll("[data-c]").forEach((el) => cObs.observe(el));

  // ─── Tech bars ───
  const bObs = new IntersectionObserver(
    (es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        el.style.width = el.dataset.w || "0";
      }),
    { threshold: 0.3 },
  );
  document.querySelectorAll(".tb-fill").forEach((b) => bObs.observe(b));
</script>

<div class="hero">
  <!-- LEFT: text content -->
  <div class="hero-left">
    <div class="hero-eyebrow"><span></span>技术 · 实验 · 思考碎片</div>
    <h1 class="hero-h1">
      <span class="li">探索数字边界</span>
      <span class="lg">的思维实验室</span>
    </h1>
    <p class="hero-desc">
      深度技术文章、WebGPU 图形实验、Rust 性能研究，<br />
      以及关于软件美学与工程哲学的不定期碎片记录。
    </p>
    <div class="hero-actions">
      <a href="#articles" class="btn btn-fill">开始阅读</a>
      <a href="#lab" class="btn btn-line">进入实验室 →</a>
    </div>
    <div class="hero-stats">
      <div class="hs">
        <div class="hs-num">47<em>+</em></div>
        <div class="hs-lbl">技术文章</div>
      </div>
      <div class="hs">
        <div class="hs-num">12<em>×</em></div>
        <div class="hs-lbl">交互实验</div>
      </div>
      <div class="hs">
        <div class="hs-num">2<em>y</em></div>
        <div class="hs-lbl">持续写作</div>
      </div>
    </div>
  </div>

  <!-- RIGHT: rich visual panel -->
  <div class="hero-right">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="orb orb3"></div>
    <canvas id="hero-canvas"></canvas>
    <div class="hero-grid-overlay"></div>
    <div class="hero-badge">WebGPU · Live Preview</div>

    <!-- Floating article preview cards -->
    <div class="fc fc-1">
      <span class="fc-tag gpu">WebGPU</span>
      <div class="fc-title">实时光线追踪渲染器</div>
      <div class="fc-meta">
        <span>18 min</span>
        <div class="fc-bar">
          <div class="fc-bar-fill" style="width:78%"></div>
        </div>
        <span style="color:var(--accent)">↗</span>
      </div>
      <div class="fc-views">3,240 次阅读</div>
    </div>

    <div class="fc fc-2">
      <span class="fc-tag wasm">Rust+WASM</span>
      <div class="fc-title">WASM 性能极限探索</div>
      <div class="fc-meta">
        <span>12 min</span>
        <div class="fc-bar">
          <div
            class="fc-bar-fill"
            style="width:56%;background:linear-gradient(90deg,var(--accent3),var(--accent))"
          >
          </div>
        </div>
        <span style="color:var(--accent3)">↗</span>
      </div>
      <div class="fc-views">1,890 次阅读</div>
    </div>

    <div class="fc fc-3">
      <span class="fc-tag css">WGSL</span>
      <div class="fc-title">着色器噪声的数学原理</div>
      <div class="fc-meta">
        <span>10 min</span>
        <div class="fc-bar">
          <div
            class="fc-bar-fill"
            style="width:43%;background:linear-gradient(90deg,var(--accent2),var(--accent))"
          >
          </div>
        </div>
        <span style="color:var(--accent2)">↗</span>
      </div>
      <div class="fc-views">2,105 次阅读</div>
    </div>
  </div>
</div>

<style>
  /* ═══════════════════ HERO ═══════════════════ */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* nav 60px + border 1px + ticker 32px = 93px */
    padding-top: 93px;
    position: relative;
    overflow: hidden;
  }

  /* LEFT */
  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 56px 60px 48px;
    position: relative;
    z-index: 3;
  }
  .hero-eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    animation: fU 0.7s 0.15s forwards;
  }
  .hero-eyebrow span {
    width: 28px;
    height: 1px;
    background: var(--accent);
    display: block;
    flex-shrink: 0;
  }
  .hero-h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.8rem, 4.2vw, 5rem);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 20px;
    opacity: 0;
    animation: fU 0.85s 0.3s forwards;
  }
  .hero-h1 .li {
    font-style: italic;
    color: var(--accent2);
    display: block;
  }
  .hero-h1 .lg {
    display: block;
    background: linear-gradient(
      135deg,
      #fff 40%,
      var(--accent) 75%,
      var(--accent2)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-desc {
    font-family: "Noto Serif SC", serif;
    font-weight: 300;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.9;
    max-width: 430px;
    margin-bottom: 36px;
    opacity: 0;
    animation: fU 0.85s 0.45s forwards;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    align-items: center;
    opacity: 0;
    animation: fU 0.85s 0.6s forwards;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    gap: 0;
    margin-top: 40px;
    border-top: 1px solid var(--border);
    padding-top: 24px;
    opacity: 0;
    animation: fU 0.85s 0.75s forwards;
  }
  .hs {
    flex: 1;
  }
  .hs + .hs {
    padding-left: 28px;
    border-left: 1px solid var(--border);
  }
  .hs-num {
    font-family: "Playfair Display", serif;
    font-size: 1.9rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .hs-num em {
    font-size: 1rem;
    font-style: normal;
    color: var(--accent);
  }
  .hs-lbl {
    font-size: 0.63rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    margin-top: 4px;
  }

  /* RIGHT PANEL */
  .hero-right {
    position: relative;
    overflow: hidden;
    background: var(--bg2);
    border-left: none;
  }
  /* Smooth left-to-right fade: bg bleeds into the visual panel */
  .hero-right::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 180px;
    height: 100%;
    background: linear-gradient(
      to right,
      var(--bg) 0%,
      rgba(9, 9, 15, 0.7) 40%,
      transparent 100%
    );
    z-index: 5;
    pointer-events: none;
  }
  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(124, 106, 245, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124, 106, 245, 0.04) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: radial-gradient(
      ellipse 85% 85% at 60% 50%,
      black 30%,
      transparent
    );
    pointer-events: none;
    z-index: 1;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }
  .orb1 {
    width: 320px;
    height: 320px;
    background: rgba(124, 106, 245, 0.12);
    top: 5%;
    right: 5%;
    z-index: 1;
  }
  .orb2 {
    width: 240px;
    height: 240px;
    background: rgba(245, 162, 106, 0.08);
    bottom: 12%;
    left: 8%;
    z-index: 1;
  }
  .orb3 {
    width: 180px;
    height: 180px;
    background: rgba(106, 245, 200, 0.07);
    top: 50%;
    right: 12%;
    z-index: 1;
  }

  /* Floating cards */
  .fc {
    position: absolute;
    z-index: 4;
    background: rgba(10, 10, 22, 0.88);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 16px 18px;
    min-width: 210px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
    animation: floatCard 7s ease-in-out infinite;
  }
  .fc-1 {
    top: 16%;
    left: 7%;
    animation-delay: 0s;
  }
  .fc-2 {
    top: 46%;
    right: 5%;
    animation-delay: -2.5s;
  }
  .fc-3 {
    bottom: 22%;
    left: 10%;
    animation-delay: -4.8s;
  }
  @keyframes floatCard {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
    }
    50% {
      transform: translateY(-14px) rotate(0.5deg);
    }
  }
  .fc-tag {
    font-size: 0.58rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 8px;
    padding: 2px 7px;
    border-radius: 2px;
    display: inline-block;
  }
  .fc-tag.gpu {
    color: #f56a6a;
    background: rgba(245, 106, 106, 0.12);
    border: 1px solid rgba(245, 106, 106, 0.25);
  }
  .fc-tag.wasm {
    color: var(--accent3);
    background: rgba(106, 245, 200, 0.1);
    border: 1px solid rgba(106, 245, 200, 0.2);
  }
  .fc-tag.css {
    color: var(--accent);
    background: rgba(124, 106, 245, 0.1);
    border: 1px solid rgba(124, 106, 245, 0.25);
  }
  .fc-title {
    font-family: "Playfair Display", serif;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .fc-meta {
    color: var(--muted);
    font-size: 0.68rem;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .fc-bar {
    height: 2px;
    flex: 1;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 1px;
    overflow: hidden;
  }
  .fc-bar-fill {
    height: 100%;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
  }
  .fc-views {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    font-size: 0.63rem;
    color: var(--muted);
  }
  .fc-views::before {
    content: "👁";
    font-size: 0.7rem;
  }

  .hero-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 4;
    background: rgba(124, 106, 245, 0.15);
    border: 1px solid rgba(124, 106, 245, 0.3);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 0.63rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    backdrop-filter: blur(8px);
  }
</style>

<script>
  // ─── Hero Canvas: wave oscillator + particles ───
  (function () {
    const cv = document.getElementById("hero-canvas") as HTMLCanvasElement;
    if (!cv) return;
    const ctx = cv.getContext("2d");
    function resize() {
      cv.width = cv.offsetWidth;
      cv.height = cv.offsetHeight;
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(cv.parentElement as Element);

    // Particles
    const NPTS = 90;
    const pts = Array.from({ length: NPTS }, () => ({
      x: Math.random(),
      y: Math.random(),
      vx: (Math.random() - 0.5) * 0.0004,
      vy: (Math.random() - 0.5) * 0.0004,
      r: Math.random() * 1.6 + 0.4,
      a: Math.random(),
      phase: Math.random() * Math.PI * 2,
    }));

    // Wave layers config
    const waves = [
      {
        amp: 0.055,
        freq: 2.1,
        speed: 0.38,
        phase: 0,
        color: "rgba(124,106,245,",
        lw: 1.5,
      },
      {
        amp: 0.038,
        freq: 3.4,
        speed: 0.55,
        phase: 1.2,
        color: "rgba(106,245,200,",
        lw: 1.0,
      },
      {
        amp: 0.028,
        freq: 4.8,
        speed: 0.72,
        phase: 2.5,
        color: "rgba(245,162,106,",
        lw: 0.8,
      },
      {
        amp: 0.018,
        freq: 6.2,
        speed: 1.1,
        phase: 0.8,
        color: "rgba(180,160,255,",
        lw: 0.6,
      },
    ];

    let t = 0;
    function draw() {
      const W = cv.width,
        H = cv.height;
      if (!W || !H) {
        t += 0.016;
        requestAnimationFrame(draw);
        return;
      }
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);

      // Dark base
      ctx.fillStyle = "#08080f";
      ctx.fillRect(0, 0, W, H);

      // ── Wave layers ──
      waves.forEach((w, wi) => {
        const centerY = H * (0.35 + wi * 0.1);
        const steps = W;
        // Glow pass (wide, low alpha)
        ctx.beginPath();
        for (let x = 0; x <= steps; x++) {
          const nx = x / steps;
          const y =
            centerY +
            Math.sin(nx * Math.PI * 2 * w.freq + t * w.speed + w.phase) *
              H *
              w.amp +
            Math.sin(
              nx * Math.PI * 2 * w.freq * 1.7 + t * w.speed * 0.6 + w.phase,
            ) *
              H *
              w.amp *
              0.4;
          x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.strokeStyle = w.color + "0.06)";
        ctx.lineWidth = w.lw * 10;
        ctx.stroke();
        // Sharp line
        ctx.beginPath();
        for (let x = 0; x <= steps; x++) {
          const nx = x / steps;
          const y =
            centerY +
            Math.sin(nx * Math.PI * 2 * w.freq + t * w.speed + w.phase) *
              H *
              w.amp +
            Math.sin(
              nx * Math.PI * 2 * w.freq * 1.7 + t * w.speed * 0.6 + w.phase,
            ) *
              H *
              w.amp *
              0.4;
          x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.strokeStyle = w.color + "0.55)";
        ctx.lineWidth = w.lw;
        ctx.stroke();
      });

      // ── Particles ──
      pts.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = 1;
        if (p.x > 1) p.x = 0;
        if (p.y < 0) p.y = 1;
        if (p.y > 1) p.y = 0;
        const pulse = 0.35 + Math.sin(t * 1.2 + p.phase) * 0.35;
        ctx.beginPath();
        ctx.arc(p.x * W, p.y * H, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(160,148,255,${pulse * 0.7})`;
        ctx.fill();
      });

      // ── Connection lines between close particles ──
      for (let i = 0; i < NPTS; i++) {
        for (let j = i + 1; j < NPTS; j++) {
          const dx = (pts[i].x - pts[j].x) * W,
            dy = (pts[i].y - pts[j].y) * H;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 80) {
            ctx.beginPath();
            ctx.moveTo(pts[i].x * W, pts[i].y * H);
            ctx.lineTo(pts[j].x * W, pts[j].y * H);
            ctx.strokeStyle = `rgba(124,106,245,${(1 - d / 80) * 0.18})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      // ── Horizontal scan line ──
      const scanY = ((t * 0.12) % 1) * H;
      const scanGrad = ctx.createLinearGradient(0, scanY - 1, 0, scanY + 1);
      scanGrad.addColorStop(0, "transparent");
      scanGrad.addColorStop(0.5, "rgba(124,106,245,0.25)");
      scanGrad.addColorStop(1, "transparent");
      ctx.fillStyle = scanGrad;
      ctx.fillRect(0, scanY - 2, W, 4);

      t += 0.016;
      requestAnimationFrame(draw);
    }
    draw();
  })();
</script>

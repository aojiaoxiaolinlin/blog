---
import "../styles/components/home-hero.css";
---

<div class="home-hero">
  <!-- LEFT: text content -->
  <div class="hero-left">
    <div class="hero-eyebrow"><span></span>技术 · 实验 · 思考碎片</div>
    <h1 class="hero-h1">
      <span class="li">探索数字边界</span>
      <span class="lg">的思维实验室</span>
    </h1>
    <p class="hero-desc">
      深度技术文章、WebGPU 图形实验、Rust 性能研究，<br />
      以及关于软件美学与工程哲学的不定期碎片记录。
    </p>
    <div class="hero-actions">
      <a href="#articles" class="btn btn-fill">开始阅读</a>
      <a href="#lab" class="btn btn-line">进入实验室 →</a>
    </div>
    <div class="hero-stats">
      <div class="hs">
        <div class="hs-num">47<em>+</em></div>
        <div class="hs-lbl">技术文章</div>
      </div>
      <div class="hs">
        <div class="hs-num">12<em>×</em></div>
        <div class="hs-lbl">交互实验</div>
      </div>
      <div class="hs">
        <div class="hs-num">2<em>y</em></div>
        <div class="hs-lbl">持续写作</div>
      </div>
    </div>
  </div>

  <!-- RIGHT: rich visual panel -->
  <div class="hero-right">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="orb orb3"></div>
    <canvas id="hero-canvas"></canvas>
    <div class="hero-grid-overlay"></div>
    <div class="hero-badge">WebGPU · Live Preview</div>

    <!-- Floating article preview cards -->
    <div class="fc fc-1">
      <span class="fc-tag gpu">WebGPU</span>
      <div class="fc-title">实时光线追踪渲染器</div>
      <div class="fc-meta">
        <span>18 min</span>
        <div class="fc-bar">
          <div class="fc-bar-fill fill-78"></div>
        </div>
        <span class="fc-arrow accent">↗</span>
      </div>
      <div class="fc-views">3,240 次阅读</div>
    </div>

    <div class="fc fc-2">
      <span class="fc-tag wasm">Rust+WASM</span>
      <div class="fc-title">WASM 性能极限探索</div>
      <div class="fc-meta">
        <span>12 min</span>
        <div class="fc-bar">
          <div class="fc-bar-fill fill-56 tone-mint"></div>
        </div>
        <span class="fc-arrow mint">↗</span>
      </div>
      <div class="fc-views">1,890 次阅读</div>
    </div>

    <div class="fc fc-3">
      <span class="fc-tag css">WGSL</span>
      <div class="fc-title">着色器噪声的数学原理</div>
      <div class="fc-meta">
        <span>10 min</span>
        <div class="fc-bar">
          <div class="fc-bar-fill fill-43 tone-warm"></div>
        </div>
        <span class="fc-arrow warm">↗</span>
      </div>
      <div class="fc-views">2,105 次阅读</div>
    </div>
  </div>
</div>

<script>
  // ─── Hero Canvas: wave oscillator + particles ───
  (function () {
    const cv = document.getElementById("hero-canvas") as HTMLCanvasElement;
    if (!cv) return;
    const ctx = cv.getContext("2d");
    function resize() {
      cv.width = cv.offsetWidth;
      cv.height = cv.offsetHeight;
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(cv.parentElement as Element);

    // Particles
    const NPTS = 90;
    const pts = Array.from({ length: NPTS }, () => ({
      x: Math.random(),
      y: Math.random(),
      vx: (Math.random() - 0.5) * 0.0004,
      vy: (Math.random() - 0.5) * 0.0004,
      r: Math.random() * 1.6 + 0.4,
      a: Math.random(),
      phase: Math.random() * Math.PI * 2,
    }));

    // Wave layers config
    const waves = [
      {
        amp: 0.055,
        freq: 2.1,
        speed: 0.38,
        phase: 0,
        color: "rgba(124,106,245,",
        lw: 1.5,
      },
      {
        amp: 0.038,
        freq: 3.4,
        speed: 0.55,
        phase: 1.2,
        color: "rgba(106,245,200,",
        lw: 1.0,
      },
      {
        amp: 0.028,
        freq: 4.8,
        speed: 0.72,
        phase: 2.5,
        color: "rgba(245,162,106,",
        lw: 0.8,
      },
      {
        amp: 0.018,
        freq: 6.2,
        speed: 1.1,
        phase: 0.8,
        color: "rgba(180,160,255,",
        lw: 0.6,
      },
    ];

    let t = 0;
    function draw() {
      const W = cv.width,
        H = cv.height;
      if (!W || !H) {
        t += 0.016;
        requestAnimationFrame(draw);
        return;
      }
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);

      // Dark base
      ctx.fillStyle = "#08080f";
      ctx.fillRect(0, 0, W, H);

      // ── Wave layers ──
      waves.forEach((w, wi) => {
        const centerY = H * (0.35 + wi * 0.1);
        const steps = W;
        // Glow pass (wide, low alpha)
        ctx.beginPath();
        for (let x = 0; x <= steps; x++) {
          const nx = x / steps;
          const y =
            centerY +
            Math.sin(nx * Math.PI * 2 * w.freq + t * w.speed + w.phase) *
              H *
              w.amp +
            Math.sin(
              nx * Math.PI * 2 * w.freq * 1.7 + t * w.speed * 0.6 + w.phase,
            ) *
              H *
              w.amp *
              0.4;
          x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.strokeStyle = w.color + "0.06)";
        ctx.lineWidth = w.lw * 10;
        ctx.stroke();
        // Sharp line
        ctx.beginPath();
        for (let x = 0; x <= steps; x++) {
          const nx = x / steps;
          const y =
            centerY +
            Math.sin(nx * Math.PI * 2 * w.freq + t * w.speed + w.phase) *
              H *
              w.amp +
            Math.sin(
              nx * Math.PI * 2 * w.freq * 1.7 + t * w.speed * 0.6 + w.phase,
            ) *
              H *
              w.amp *
              0.4;
          x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.strokeStyle = w.color + "0.55)";
        ctx.lineWidth = w.lw;
        ctx.stroke();
      });

      // ── Particles ──
      pts.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = 1;
        if (p.x > 1) p.x = 0;
        if (p.y < 0) p.y = 1;
        if (p.y > 1) p.y = 0;
        const pulse = 0.35 + Math.sin(t * 1.2 + p.phase) * 0.35;
        ctx.beginPath();
        ctx.arc(p.x * W, p.y * H, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(160,148,255,${pulse * 0.7})`;
        ctx.fill();
      });

      // ── Connection lines between close particles ──
      for (let i = 0; i < NPTS; i++) {
        for (let j = i + 1; j < NPTS; j++) {
          const dx = (pts[i].x - pts[j].x) * W,
            dy = (pts[i].y - pts[j].y) * H;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 80) {
            ctx.beginPath();
            ctx.moveTo(pts[i].x * W, pts[i].y * H);
            ctx.lineTo(pts[j].x * W, pts[j].y * H);
            ctx.strokeStyle = `rgba(124,106,245,${(1 - d / 80) * 0.18})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      // ── Horizontal scan line ──
      const scanY = ((t * 0.12) % 1) * H;
      const scanGrad = ctx.createLinearGradient(0, scanY - 1, 0, scanY + 1);
      scanGrad.addColorStop(0, "transparent");
      scanGrad.addColorStop(0.5, "rgba(124,106,245,0.25)");
      scanGrad.addColorStop(1, "transparent");
      ctx.fillStyle = scanGrad;
      ctx.fillRect(0, scanY - 2, W, 4);

      t += 0.016;
      requestAnimationFrame(draw);
    }
    draw();
  })();
</script>

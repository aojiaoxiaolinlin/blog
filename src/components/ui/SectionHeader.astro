---
interface Props {
  label: string;
  title: string;
  href?: string;
  linkText?: string;
  class?: string;
}

const {
  label,
  title,
  href,
  linkText,
  class: className,
} = Astro.props;
---

<div class:list={["section-hd rv", className]}>
  <div>
    <div class="mb-2 text-[0.63rem] uppercase tracking-[0.22em] text-accent">
      {label}
    </div>
    <h2 class="section-title">{title}</h2>
  </div>

  {
    href && linkText && (
      <a href={href} class="section-link">
        {linkText}
      </a>
    )
  }
</div>

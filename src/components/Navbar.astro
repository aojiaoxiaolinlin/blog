---
import ThemeToggle from "./ThemeToggle.astro";
import "../styles/components/navbar.css";

interface Props {
  activePath?: string;
}

const { activePath = "/" } = Astro.props;
---

<nav id="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/">VOID<em>.dev</em></a>
    <ul class="nav-links">
      <li>
        <a
          href={activePath === "/" ? "/#articles" : "/articles"}
          class={activePath === "/" || activePath === "/articles" ? "active" : ""}
        >文章</a>
      </li>
      <li><a href="/#lab">实验室</a></li>
      <li>
        <a
          href={activePath === "/" ? "/#notes" : "/notes"}
          class={activePath === "/notes" ? "active" : ""}
        >笔记</a>
      </li>
      <li>
        <a href="/about" class={activePath === "/about" ? "active" : ""}
          >关于</a>
      </li>
    </ul>
    <div class="nav-right">
      <div class="nav-dot">
        <div class="pulse"></div><span>正在写作中</span>
      </div>
      <ThemeToggle />
      <button
        class="nav-menu-toggle"
        type="button"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  <div class="mobile-nav-panel" id="mobile-nav-panel" data-open="false">
    <a
      href={activePath === "/" ? "/#articles" : "/articles"}
      class={activePath === "/" || activePath === "/articles" ? "active" : ""}
    >
      <span>01</span>文章
    </a>
    <a href="/#lab"><span>02</span>实验室</a>
    <a
      href={activePath === "/" ? "/#notes" : "/notes"}
      class={activePath === "/notes" ? "active" : ""}
    >
      <span>03</span>笔记
    </a>
    <a href="/about" class={activePath === "/about" ? "active" : ""}>
      <span>04</span>关于
    </a>
  </div>
  <!-- TICKER directly under nav bar -->
  <div class="ticker-bar">
    <div class="ticker-track" id="ticker">
      <span class="ticker-item">WebGPU Compute Shader</span>
      <span class="ticker-item">Rust → WASM 性能优化</span>
      <span class="ticker-item">着色器艺术实验</span>
      <span class="ticker-item">浏览器渲染引擎内幕</span>
      <span class="ticker-item">现代 CSS 排版</span>
      <span class="ticker-item">编译器原理基础</span>
      <span class="ticker-item">图形管线深度解析</span>
      <span class="ticker-item">实时光线追踪算法</span>
      <span class="ticker-item">WebGPU Compute Shader</span>
      <span class="ticker-item">Rust → WASM 性能优化</span>
      <span class="ticker-item">着色器艺术实验</span>
      <span class="ticker-item">浏览器渲染引擎内幕</span>
      <span class="ticker-item">现代 CSS 排版</span>
      <span class="ticker-item">编译器原理基础</span>
      <span class="ticker-item">图形管线深度解析</span>
      <span class="ticker-item">实时光线追踪算法</span>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("nav");
  const toggle = nav?.querySelector(".nav-menu-toggle");
  const panel = document.getElementById("mobile-nav-panel");

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.dataset.open = open ? "true" : "false";
      toggle.setAttribute("aria-expanded", String(open));
      nav?.classList.toggle("is-menu-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(panel.dataset.open !== "true");
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 720) setOpen(false);
    });
  }
</script>

---
import SectionHeader from "./ui/SectionHeader.astro";
import "../styles/components/lab.css";
---

<section id="lab" class="lab-bg">
  <div class="wrap">
    <SectionHeader
      label="交互实验室"
      title="实时运行的实验"
    />
    <div class="lab-grid rv">
      <a href="/lab/triangle" class="lc panel-card panel-card--interactive">
        <div class="lc-vis">
          <canvas id="lc1" width="400" height="200"></canvas><div
            class="lc-overlay"
          >
          </div><span class="lc-badge status-badge status-badge--accent">NEW</span>
        </div>
        <div class="lc-body">
          <h3 class="lc-title">Rust + wgpu Triangle</h3><p class="lc-desc">
            最小可运行渲染实验：通过 `wasm-pack` 将 Rust + wgpu 编译到浏览器，
            创建 WebGPU pipeline 并绘制一个彩色三角形。
          </p><div class="lc-tech">
            <span class="meta-chip">Rust</span><span class="meta-chip">WASM</span><span class="meta-chip">wgpu</span>
          </div>
        </div>
      </a>
      <div class="lc panel-card panel-card--interactive">
        <div class="lc-vis">
          <canvas id="lc2" width="400" height="200"></canvas><div
            class="lc-overlay"
          >
          </div><span class="lc-badge status-badge status-badge--mint">LIVE</span>
        </div>
        <div class="lc-body">
          <h3 class="lc-title">分形噪声生成器</h3><p class="lc-desc">
            实时可调参数的多八度 Perlin / Simplex 噪声，可导出 PNG。
          </p><div class="lc-tech">
            <span class="meta-chip">Canvas 2D</span><span class="meta-chip">WASM</span><span class="meta-chip">Rust</span>
          </div>
        </div>
      </div>
      <div class="lc panel-card panel-card--interactive">
        <div class="lc-vis">
          <canvas id="lc3" width="400" height="200"></canvas><div
            class="lc-overlay"
          >
          </div><span class="lc-badge status-badge status-badge--warm">WIP</span>
        </div>
        <div class="lc-body">
          <h3 class="lc-title">WGSL 着色器游乐场</h3><p class="lc-desc">
            实时编辑 WGSL 着色器代码并即时看到渲染结果，带错误高亮。
          </p><div class="lc-tech">
            <span class="meta-chip">WebGPU</span><span class="meta-chip">WGSL</span><span class="meta-chip">CodeMirror</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ─── Lab Canvas 1: particles ───
  (function () {
    const cv = document.getElementById("lc1") as HTMLCanvasElement;
    if (!cv) return;
    const ctx = cv.getContext("2d");
    if (!ctx) return;
    (function draw() {
      const grad = ctx.createLinearGradient(0, 0, cv.width, cv.height);
      grad.addColorStop(0, "#060611");
      grad.addColorStop(1, "#0d1024");
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, cv.width, cv.height);
      ctx.strokeStyle = "rgba(124,106,245,0.15)";
      ctx.lineWidth = 1;
      for (let i = 0; i <= 10; i++) {
        const y = (cv.height / 10) * i;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(cv.width, y);
        ctx.stroke();
      }

      const t = performance.now() * 0.001;
      const wobble = Math.sin(t) * 6;
      const points = [
        { x: cv.width * 0.5, y: cv.height * 0.24 + wobble, color: "#7c6af5" },
        { x: cv.width * 0.2 - wobble, y: cv.height * 0.76, color: "#6af5c8" },
        { x: cv.width * 0.8 + wobble, y: cv.height * 0.76, color: "#f5a26a" },
      ];

      ctx.save();
      ctx.shadowBlur = 24;
      ctx.shadowColor = "rgba(124,106,245,0.35)";
      ctx.beginPath();
      ctx.moveTo(points[0].x, points[0].y);
      ctx.lineTo(points[1].x, points[1].y);
      ctx.lineTo(points[2].x, points[2].y);
      ctx.closePath();
      const fill = ctx.createLinearGradient(
        points[0].x,
        points[0].y,
        points[2].x,
        points[2].y,
      );
      fill.addColorStop(0, "rgba(124,106,245,0.9)");
      fill.addColorStop(0.5, "rgba(106,245,200,0.86)");
      fill.addColorStop(1, "rgba(245,162,106,0.9)");
      ctx.fillStyle = fill;
      ctx.fill();
      ctx.restore();

      ctx.lineWidth = 2;
      ctx.strokeStyle = "rgba(255,255,255,0.28)";
      ctx.beginPath();
      ctx.moveTo(points[0].x, points[0].y);
      ctx.lineTo(points[1].x, points[1].y);
      ctx.lineTo(points[2].x, points[2].y);
      ctx.closePath();
      ctx.stroke();

      points.forEach((point) => {
        ctx.beginPath();
        ctx.fillStyle = point.color;
        ctx.arc(point.x, point.y, 5.5, 0, Math.PI * 2);
        ctx.fill();
      });

      requestAnimationFrame(draw);
    })();
  })();

  // ─── Lab Canvas 2: noise ───
  (function () {
    const cv = document.getElementById("lc2") as HTMLCanvasElement;
    if (!cv) return;
    const ctx = cv.getContext("2d");
    let t = 0;
    const perm = new Array(256)
      .fill(0)
      .map((_, i) => i)
      .sort(() => Math.random() - 0.5);
    function fade(t: number) {
      return t * t * t * (t * (t * 6 - 15) + 10);
    }
    function lerp(t: number, a: number, b: number) {
      return a + t * (b - a);
    }
    function grad(h: number, x: number, y: number) {
      h &= 3;
      const u = h < 2 ? x : y,
        v = h < 2 ? y : x;
      return (h & 1 ? -u : u) + (h & 2 ? -v : v);
    }
    function noise(x: number, y: number) {
      const X = Math.floor(x) & 255,
        Y = Math.floor(y) & 255;
      x -= Math.floor(x);
      y -= Math.floor(y);
      const u = fade(x),
        v = fade(y);
      return lerp(
        v,
        lerp(
          u,
          grad(perm[X + perm[Y]], x, y),
          grad(perm[X + 1 + perm[Y]], x - 1, y),
        ),
        lerp(
          u,
          grad(perm[X + perm[Y + 1]], x, y - 1),
          grad(perm[X + 1 + perm[Y + 1]], x - 1, y - 1),
        ),
      );
    }
    (function draw() {
      if (!ctx) return;
      const id = ctx.createImageData(cv.width, cv.height),
        d = id.data;
      for (let y = 0; y < cv.height; y++)
        for (let x = 0; x < cv.width; x++) {
          const n = noise(x / 45 + t, y / 45) * 0.5 + 0.5;
          const r = Math.floor(n * 90 + 50),
            g = Math.floor(n * 55 + 20),
            b = Math.floor(n * 175 + 70);
          const i = (y * cv.width + x) * 4;
          d[i] = r;
          d[i + 1] = g;
          d[i + 2] = b;
          d[i + 3] = 255;
        }
      ctx.putImageData(id, 0, 0);
      t += 0.007;
      requestAnimationFrame(draw);
    })();
  })();

  // ─── Lab Canvas 3: torus ───
  (function () {
    const cv = document.getElementById("lc3") as HTMLCanvasElement;
    if (!cv) return;
    const ctx = cv.getContext("2d");
    const R = 52,
      r = 21,
      nu = 36,
      nv = 18,
      pts3d = [];
    for (let i = 0; i < nu; i++)
      for (let j = 0; j < nv; j++) {
        const u = (i / nu) * Math.PI * 2,
          v = (j / nv) * Math.PI * 2;
        pts3d.push({
          x: (R + r * Math.cos(v)) * Math.cos(u),
          y: (R + r * Math.cos(v)) * Math.sin(u),
          z: r * Math.sin(v),
        });
      }
    let rx = 0,
      ry = 0;
    function rotX(p: { x: number; y: number; z: number }, a: number) {
      const y = p.y * Math.cos(a) - p.z * Math.sin(a),
        z = p.y * Math.sin(a) + p.z * Math.cos(a);
      return { ...p, y, z };
    }
    function rotY(p: { x: number; y: number; z: number }, a: number) {
      const x = p.x * Math.cos(a) + p.z * Math.sin(a),
        z = -p.x * Math.sin(a) + p.z * Math.cos(a);
      return { ...p, x, z };
    }
    function proj(p: { z: number; x: number; y: number }) {
      const f = 210,
        z = p.z + 215;
      return {
        sx: (p.x / z) * f + cv.width / 2,
        sy: (p.y / z) * f + cv.height / 2,
        d: z,
      };
    }
    (function draw() {
      if (!ctx) return;
      ctx.fillStyle = "#050510";
      ctx.fillRect(0, 0, cv.width, cv.height);
      const tf = pts3d.map((p) => proj(rotY(rotX(p, rx), ry)));
      for (let i = 0; i < nu; i++)
        for (let j = 0; j < nv; j++) {
          const a = tf[i * nv + j],
            b = tf[i * nv + ((j + 1) % nv)],
            c = tf[((i + 1) % nu) * nv + j];
          const al = Math.min(1, (a.d - 155) / 140);
          ctx.strokeStyle = `rgba(124,106,245,${al * 0.65})`;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.moveTo(a.sx, a.sy);
          ctx.lineTo(b.sx, b.sy);
          ctx.stroke();
          ctx.strokeStyle = `rgba(106,245,200,${al * 0.3})`;
          ctx.beginPath();
          ctx.moveTo(a.sx, a.sy);
          ctx.lineTo(c.sx, c.sy);
          ctx.stroke();
        }
      rx += 0.007;
      ry += 0.012;
      requestAnimationFrame(draw);
    })();
  })();
</script>

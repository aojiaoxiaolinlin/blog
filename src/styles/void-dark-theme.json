{
  "$schema": "vscode://schemas/color-theme",
  "name": "void-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#070712",
    "editor.foreground": "#e8e6f0",
    "editor.lineHighlightBackground": "#FFFFFF0A",
    "editorLineNumber.foreground": "#ffffff26",
    "editorLineNumber.activeForeground": "#7c6af5b3",
    "editor.selectionBackground": "#7c6af540",
    "editorCursor.foreground": "#7c6af5"
  },
  "tokenColors": [
    {
      "name": "Default text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#e8e6f0"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b57af5"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#7af5c4"
      }
    },
    {
      "name": "Types, Classes, Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#f5a26a"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#f5c26a"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f56a9a"
      }
    },
    {
      "name": "Punctuation & Operators",
      "scope": [
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#6af5f5"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b6880",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other"
      ],
      "settings": {
        "foreground": "#e8e6f0"
      }
    },
    {
      "name": "Attributes / Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "keyword.other.attribute"
      ],
      "settings": {
        "foreground": "#b57af5"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "storage.modifier.lifetime.rust"
      ],
      "settings": {
        "foreground": "#f5a26a"
      }
    },
    {
      "name": "Rust Macros",
      "scope": [
        "entity.name.function.macro.rust"
      ],
      "settings": {
        "foreground": "#7af5c4"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f0eeff"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f5a26a"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#6af5c8"
      }
    }
  ]
}
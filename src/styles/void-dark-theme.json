{
  "$schema": "vscode://schemas/color-theme",
  "name": "void-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#070712",
    "editor.foreground": "#f3efff",
    "editor.lineHighlightBackground": "#8E7DFF14",
    "editorLineNumber.foreground": "#ffffff26",
    "editorLineNumber.activeForeground": "#b09cff",
    "editor.selectionBackground": "#8e7dff40",
    "editorCursor.foreground": "#8e7dff"
  },
  "tokenColors": [
    {
      "name": "Default text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#e8e6f0"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d3a6ff"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#7fffd4"
      }
    },
    {
      "name": "Types, Classes, Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#ffb07a"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#ffd86f"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#ff8fb1"
      }
    },
    {
      "name": "Punctuation & Operators",
      "scope": [
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#82dfff"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9d97b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#efe9ff"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#9fd8ff"
      }
    },
    {
      "name": "Properties & Fields",
      "scope": [
        "variable.other.property",
        "meta.property-name",
        "entity.name.tag.yaml",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#c6a8ff"
      }
    },
    {
      "name": "Constants & Enum Members",
      "scope": [
        "constant",
        "variable.other.constant",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ff9dbd"
      }
    },
    {
      "name": "Namespaces & Modules",
      "scope": [
        "entity.name.namespace",
        "support.namespace",
        "entity.name.module",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#94a8ff"
      }
    },
    {
      "name": "Builtins & Special Variables",
      "scope": [
        "support.function.builtin",
        "support.type.builtin",
        "variable.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#86f0ff"
      }
    },
    {
      "name": "String Escapes & Regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#9dffb7"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other"
      ],
      "settings": {
        "foreground": "#efe9ff"
      }
    },
    {
      "name": "Attributes / Decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "keyword.other.attribute"
      ],
      "settings": {
        "foreground": "#ff8fd8"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "storage.modifier.lifetime.rust"
      ],
      "settings": {
        "foreground": "#ffb07a"
      }
    },
    {
      "name": "Rust Macros",
      "scope": [
        "entity.name.function.macro.rust"
      ],
      "settings": {
        "foreground": "#7fffd4"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f0eeff"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#f5a26a"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#6af5c8"
      }
    }
  ]
}

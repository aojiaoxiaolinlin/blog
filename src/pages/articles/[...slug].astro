---
import { getCollection, render } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

dayjs.extend(utc);
import "../../styles/article-page.css";
import Layout from "../../layouts/Layout.astro";
import ArticleFooter from "../../components/article/ArticleFooter.astro";
import ArticleHeader from "../../components/article/ArticleHeader.astro";
import ArticleNav from "../../components/article/ArticleNav.astro";
import ArticleShareSidebar from "../../components/article/ArticleShareSidebar.astro";
import ArticleToc from "../../components/article/ArticleToc.astro";
import Blockquote from "../../components/mdx/Blockquote.astro";

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(article);

export const components = {
  blockquote: Blockquote,
};

const formatDate = (date: Date) => {
  const yy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  return `${yy}.${mm}.${dd}`;
};

const lastModified = dayjs(remarkPluginFrontmatter.lastModified)
  .utc()
  .format("YYYY.MM.DD HH:mm:ss");

const toc = headings
  ? (headings.filter(
      (h: { depth: number }) => h.depth === 2 || h.depth === 3,
    ) as TocItem[])
  : [];

const minutesRead = remarkPluginFrontmatter.minutesRead || 5;
const tags = article.data.tags || [];
const articleDate = formatDate(article.data.date);
---

<Layout title={`${article.data.title} - VOID.DEV`}>
  <div id="progress-bar"></div>

  <ArticleNav title={article.data.title} />

  <div class="page-layout">
    <ArticleToc items={toc} minutesRead={minutesRead} />

    <main class="article-main" id="articleMain">
      <ArticleHeader
        title={article.data.title}
        description={article.data.description}
        date={articleDate}
        lastModified={lastModified}
        minutesRead={minutesRead}
        tags={tags}
      />

      <article class="prose" id="prose">
        <Content components={components} />
      </article>

      <ArticleFooter tags={tags} />
    </main>

    <ArticleShareSidebar />
  </div>
</Layout>

<script>
  // ── Reading progress ──
  const bar = document.getElementById("progress-bar");
  const ring = document.getElementById("ringFill");
  const pctLabel = document.getElementById("ringPct");
  const navTitle = document.getElementById("navTitle");
  function updateProgress() {
    const el = document.getElementById("articleMain");
    if (!el || !bar || !ring || !pctLabel || !navTitle) return;
    const rect = el.getBoundingClientRect();
    const total = el.offsetHeight - window.innerHeight;
    const scrolled = Math.max(0, -rect.top);
    const pct = Math.min(1, total > 0 ? scrolled / total : 1);
    bar.style.width = pct * 100 + "%";
    ring.style.strokeDashoffset = (113 - 113 * pct).toString();
    pctLabel.textContent = Math.floor(pct * 100) + "% 已读";
    navTitle.classList.toggle("show", scrolled > 100);
  }
  window.addEventListener("scroll", updateProgress, { passive: true });

  // ── TOC active state ──
  const tocLinks = document.querySelectorAll(".toc-link");
  const sections = [...document.querySelectorAll(".prose h2, .prose h3")];
  function updateTOC() {
    let active: string | null = null;
    sections.forEach((s) => {
      if (s.getBoundingClientRect().top < 120) active = s.id;
    });
    tocLinks.forEach((l) => {
      const targetId = l.getAttribute("href");
      if (targetId && targetId !== "#") {
        l.classList.toggle("active", targetId === "#" + active);
      }
    });
  }
  window.addEventListener("scroll", updateTOC, { passive: true });

  // ── Scroll reveal for prose elements ──
  const revObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const target = e.target as HTMLElement;
          target.style.opacity = "1";
          target.style.transform = "none";
          revObs.unobserve(target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
  );
  document
    .querySelectorAll(
      ".prose h2,.prose h3,.prose p,.prose blockquote,.prose hr,.code-block,.callout,.pull-quote,.fig",
    )
    .forEach((el, i) => {
      const element = el as HTMLElement;
      element.style.transitionDelay = (i % 6) * 0.04 + "s";
      revObs.observe(el);
    });
</script>

---
import { getCollection, render } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

dayjs.extend(utc);
import Layout from "../../layouts/Layout.astro";
import Blockquote from "../../components/mdx/Blockquote.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(article);

export const components = {
  blockquote: Blockquote,
};

const formatDate = (date: Date) => {
  const yy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  return `${yy}.${mm}.${dd}`;
};

const lastModified = dayjs(remarkPluginFrontmatter.lastModified)
  .utc()
  .format("YYYY.MM.DD HH:mm:ss");

const toc = headings
  ? headings.filter((h: { depth: number }) => h.depth === 2 || h.depth === 3)
  : [];
---

<Layout title={`${article.data.title} - VOID.DEV`}>
  <div id="progress-bar"></div>

  <!-- NAV -->
  <nav id="nav">
    <div class="nav-inner">
      <a class="nav-logo" href="/">VOID<em>.dev</em></a>
      <span class="nav-reading">
        <span class="nav-reading-title" id="navTitle"
          >{article.data.title}
        </span>
      </span>
      <a class="nav-back" href="/">返回文章列表</a>
    </div>
  </nav>

  <!-- PAGE LAYOUT -->
  <div class="page-layout">
    <!-- LEFT: TOC -->
    <aside class="toc-sidebar">
      <svg width="0" height="0" style="position:absolute">
        <defs>
          <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#7c6af5"></stop>
            <stop offset="100%" stop-color="#f5a26a"></stop>
          </linearGradient>
        </defs>
      </svg>

      <div class="toc-label">目录</div>
      <ul class="toc-list" id="toc">
        {
          toc.map((heading: { depth: number; slug: any; text: unknown }) => (
            <li class="toc-item">
              <a
                class={`toc-link ${heading.depth === 3 ? "h3" : ""}`}
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="toc-stats">
        <div class="toc-stat">
          <div class="toc-stat-label">阅读时间</div>
          <div class="toc-stat-val">
            {remarkPluginFrontmatter.minutesRead || 5}
            <em>分钟</em>
          </div>
        </div>
      </div>

      <!-- Reading progress ring -->
      <div class="reading-ring">
        <svg width="40" height="40" class="ring-svg">
          <circle class="ring-bg" cx="20" cy="20" r="18"></circle>
          <circle class="ring-fill" id="ringFill" cx="20" cy="20" r="18"
          ></circle>
        </svg>
        <span class="ring-label" id="ringPct">0% 已读</span>
      </div>
    </aside>

    <!-- MAIN ARTICLE -->
    <main class="article-main" id="articleMain">
      <header class="article-header">
        <div class="ah-meta">
          {
            article.data.tags &&
              article.data.tags.map((tag) => (
                <>
                  <span
                    class={`ah-tag ${
                      tag.toLowerCase() === "webgpu" ? "gpu" : ""
                    }`}
                  >
                    {tag}
                  </span>
                  <span class="ah-sep">·</span>
                </>
              ))
          }
          <span>{formatDate(article.data.date)}</span>
          <span class="ah-sep">·</span>
          <span>⌛ {remarkPluginFrontmatter.minutesRead || 5} 分钟阅读</span>
        </div>
        <h1 class="ah-title">{article.data.title}</h1>
        {
          article.data.description && (
            <p class="ah-subtitle">{article.data.description}</p>
          )
        }
        <div class="ah-footer">
          <div class="ah-author">
            <div class="ah-avatar">V</div>
            <span class="ah-author-name">void</span>
          </div>
          <div class="ah-divider"></div>
          <span>3,240 次阅读</span>
          <div class="ah-divider"></div>
          <span>上次更新: {lastModified}</span>
        </div>
      </header>

      <article class="prose" id="prose">
        <Content components={components} />
      </article>

      <footer class="article-footer">
        <div class="af-tags">
          {
            article.data.tags &&
              article.data.tags.map((tag) => (
                <a href="#" class="af-tag">
                  {tag}
                </a>
              ))
          }
        </div>
      </footer>
    </main>

    <!-- RIGHT SIDEBAR -->
    <aside class="right-sidebar">
      <div class="rs-label">分享文章</div>
      <div class="rs-actions">
        <button class="rs-btn">🔗 复制链接</button>
        <button class="rs-btn">🐦 分享到 Twitter</button>
        <button class="rs-btn">⭐ 收藏文章</button>
      </div>
    </aside>
  </div>
</Layout>

<script>
  // ── Reading progress ──
  const bar = document.getElementById("progress-bar");
  const ring = document.getElementById("ringFill");
  const pctLabel = document.getElementById("ringPct");
  const navTitle = document.getElementById("navTitle");
  function updateProgress() {
    const el = document.getElementById("articleMain");
    if (!el || !bar || !ring || !pctLabel || !navTitle) return;
    const rect = el.getBoundingClientRect();
    const total = el.offsetHeight - window.innerHeight;
    const scrolled = Math.max(0, -rect.top);
    const pct = Math.min(1, total > 0 ? scrolled / total : 1);
    bar.style.width = pct * 100 + "%";
    ring.style.strokeDashoffset = (113 - 113 * pct).toString();
    pctLabel.textContent = Math.floor(pct * 100) + "% 已读";
    navTitle.classList.toggle("show", scrolled > 100);
  }
  window.addEventListener("scroll", updateProgress, { passive: true });

  // ── TOC active state ──
  const tocLinks = document.querySelectorAll(".toc-link");
  const sections = [...document.querySelectorAll(".prose h2, .prose h3")];
  function updateTOC() {
    let active: string | null = null;
    sections.forEach((s) => {
      if (s.getBoundingClientRect().top < 120) active = s.id;
    });
    tocLinks.forEach((l) => {
      const targetId = l.getAttribute("href");
      if (targetId && targetId !== "#") {
        l.classList.toggle("active", targetId === "#" + active);
      }
    });
  }
  window.addEventListener("scroll", updateTOC, { passive: true });

  // ── Scroll reveal for prose elements ──
  const revObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const target = e.target as HTMLElement;
          target.style.opacity = "1";
          target.style.transform = "none";
          revObs.unobserve(target);
        }
      });
    },
    { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
  );
  document
    .querySelectorAll(
      ".prose h2,.prose h3,.prose p,.prose blockquote,.prose hr,.code-block,.callout,.pull-quote,.fig",
    )
    .forEach((el, i) => {
      const element = el as HTMLElement;
      element.style.transitionDelay = (i % 6) * 0.04 + "s";
      revObs.observe(el);
    });
</script>

<style is:global>
  /* ── Reading progress bar ── */
  #progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--accent),
      var(--accent2),
      var(--accent3)
    );
    z-index: 200;
    width: 0%;
    transition: width 0.1s linear;
  }

  #nav {
    position: fixed;
    top: 2px;
    left: 0;
    right: 0;
    z-index: 150;
    background: rgba(12, 11, 16, 0.94);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    height: 56px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    font-family: "Playfair Display", serif;
    font-size: 1.2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #fff 30%, var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    letter-spacing: -0.03em;
  }
  .nav-logo em {
    font-style: italic;
  }
  .nav-back {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-back:hover {
    color: #fff;
  }
  .nav-back::before {
    content: "←";
    transition: transform 0.2s;
  }
  .nav-back:hover::before {
    transform: translateX(-3px);
  }
  .nav-reading {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nav-reading-title {
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .nav-reading-title.show {
    opacity: 1;
  }

  /* ── Layout ── */
  .page-layout {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 220px 1fr 220px;
    gap: 0;
    padding-top: 58px;
    min-height: 100vh;
  }

  /* ── Left sidebar (TOC) ── */
  .toc-sidebar {
    position: sticky;
    top: 58px;
    align-self: start;
    height: calc(100vh - 58px);
    overflow-y: auto;
    padding: 48px 24px 48px 40px;
    border-right: 1px solid var(--border);
  }
  .toc-sidebar::-webkit-scrollbar {
    width: 3px;
  }
  .toc-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-sidebar::-webkit-scrollbar-thumb {
    background: var(--border2);
    border-radius: 2px;
  }

  .toc-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .toc-label::before {
    content: "[ ";
  }
  .toc-label::after {
    content: " ]";
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0;
  }
  .toc-item {
    position: relative;
  }
  .toc-link {
    display: block;
    padding: 5px 0 5px 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.5;
    border-left: 1px solid transparent;
    transition:
      color 0.2s,
      border-color 0.2s,
      padding-left 0.2s;
  }
  .toc-link:hover {
    color: var(--text2);
    border-color: var(--border2);
  }
  .toc-link.active {
    color: var(--accent);
    border-color: var(--accent);
    padding-left: 18px;
  }
  .toc-link.h3 {
    font-size: 0.65rem;
    padding-left: 26px;
    opacity: 0.75;
  }
  .toc-link.h3.active {
    padding-left: 30px;
    opacity: 1;
  }

  .toc-stats {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .toc-stat {
    margin-bottom: 14px;
  }
  .toc-stat-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .toc-stat-val {
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.03em;
  }
  .toc-stat-val em {
    font-size: 0.75rem;
    font-style: normal;
    color: var(--muted);
  }

  .reading-ring {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ring-svg {
    transform: rotate(-90deg);
  }
  .ring-bg {
    fill: none;
    stroke: var(--surface2);
    stroke-width: 3;
  }
  .ring-fill {
    fill: none;
    stroke: url(#ringGrad);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 113;
    stroke-dashoffset: 113;
    transition: stroke-dashoffset 0.3s;
  }
  .ring-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    color: var(--muted);
  }

  /* ── Main article ── */
  .article-main {
    padding: 0 64px;
    border-right: 1px solid var(--border);
    min-width: 0;
  }

  /* Article Header */
  .article-header {
    padding: 56px 0 52px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 56px;
    position: relative;
  }
  .article-header::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 80px;
    height: 1px;
    background: var(--accent);
  }
  .ah-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    color: var(--muted);
  }
  .ah-tag {
    padding: 3px 9px;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: var(--surface2);
    border: 1px solid var(--border);
  }
  .ah-tag.gpu {
    color: var(--red);
    background: rgba(245, 106, 106, 0.1);
    border: 1px solid rgba(245, 106, 106, 0.25);
  }
  .ah-sep {
    color: var(--border2);
  }
  .ah-title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 24px;
  }
  .ah-subtitle {
    font-size: 1.05rem;
    color: var(--text2);
    line-height: 1.8;
    font-weight: 400;
    max-width: 560px;
    margin: 0;
  }
  .ah-footer {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    color: var(--muted);
  }
  .ah-author {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ah-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: #fff;
    font-family: "Playfair Display", serif;
  }
  .ah-author-name {
    color: var(--text);
  }
  .ah-divider {
    width: 1px;
    height: 16px;
    background: var(--border2);
  }

  /* Article footer */
  .article-footer {
    padding: 56px 0;
    margin-top: 64px;
    border-top: 1px solid var(--border);
  }
  .af-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .af-tag {
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 2px;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .af-tag:hover {
    color: var(--text);
    border-color: var(--border2);
  }

  /* ── Right sidebar ── */
  .right-sidebar {
    position: sticky;
    top: 58px;
    align-self: start;
    height: calc(100vh - 58px);
    overflow-y: auto;
    padding: 48px 40px 48px 24px;
  }
  .rs-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .rs-related {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rs-card {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    display: block;
    transition:
      background 0.2s,
      border-color 0.2s;
    position: relative;
    overflow: hidden;
  }
  .rs-card:hover {
    background: var(--surface2);
    border-color: var(--border2);
  }
  .rs-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .rs-card:hover::before {
    transform: scaleY(1);
  }
  .rs-card-tag {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.58rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .rs-card-title {
    font-family: "Playfair Display", serif;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .rs-card-time {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.6rem;
    color: var(--muted);
    margin-top: 6px;
  }

  /* Share / bookmark */
  .rs-actions {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .rs-btn {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    cursor: none;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
  }
  .rs-btn:hover {
    background: var(--surface);
    color: var(--text);
    border-color: var(--border2);
  }

  /* ── Footnote ── */
  .footnote {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    color: var(--muted);
    line-height: 1.75;
  }
  .fn-item {
    display: flex;
    gap: 10px;
    margin-bottom: 8px;
  }
  .fn-num {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* ── Animations ── */
  @keyframes fU {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .prose h2,
  .prose h3,
  .prose p,
  .code-block,
  .callout,
  .pull-quote,
  .fig {
    opacity: 0;
    animation: fU 0.5s ease forwards;
  }
  .article-header * {
    opacity: 1 !important;
    animation: none !important;
  }

  /* ── Responsive adjustments ── */
  @media (max-width: 1024px) {
    .page-layout {
      grid-template-columns: 1fr;
    }
    .toc-sidebar,
    .right-sidebar {
      display: none;
    }
    .article-main {
      padding: 0 5%;
      border-right: none;
    }
  }
</style>
